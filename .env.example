APP_NAME=Async Data Hub
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/async_data_hub
REDIS_URL=redis://redis:6379/0
HTTP_TIMEOUT_SECONDS=5.0
HTTP_CONCURRENCY_LIMIT=10
WEBHOOK_CONCURRENCY_LIMIT=5
WEBSOCKET_QUEUE_SIZE=20
CACHE_TTL_SECONDS=30
AGGREGATION_SOURCE_BASE_URL=http://127.0.0.1:8000/api/v1/mock-sources
ENABLE_IN_MEMORY_CACHE_FALLBACK=true
